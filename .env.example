# TMDB API Credentials (Required for live movie, TV & streaming data)
# Get your free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
TMDB_TOKEN=your_tmdb_read_access_bearer_token_here

# OMDb API Key (For IMDb ratings and box office)
# Get a free key at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# YouTube Data API Key (Optional official trailer lookup)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Security & Session Authentication
SESSION_SECRET=your_random_32_character_session_signing_secret
ADMIN_API_KEY=your_admin_secret_key_for_cron_and_sync
ADMIN_EMAIL=admin@moviestars.io
ADMIN_PASSWORD=your_secure_admin_password

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=moviestars_admin
POSTGRES_PASSWORD=your_secure_postgres_password
DATABASE_URL=postgresql://moviestars_admin:your_secure_postgres_password@localhost:5432/moviestars?schema=public

# Application Environment
NODE_ENV=development
